{
  "manifest_version": 3,
  "name": "Fillframe",
  "description": "Fill your video player. Simple, private, and free.",
  "version": "0.1.6",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "options_page": "src/options.html",
  "action": {
    "default_title": "Fillframe",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    },
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.netflix.com/*",
        "https://*.disneyplus.com/*"
      ],
      "js": [
        "src/content_script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
